# QumenX application .gitignore
# The root .gitignore is the repository-wide policy; these are app-local details.

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and generated output
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
src-tauri/target/
src-tauri/gen/

# Local configuration
*.local
.env
.env.*
!.env.example

# Credentials and signing material
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
*.snk

# Generated or downloaded binaries
*.exe
*.msi
*.zip
*.7z

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Scratch media and partial downloads
.cache/
.tmp/
temp/
tmp/
*.part
*.crdownload

# Local QA fixtures and captures
/test-*
/desktop-screenshot.png
